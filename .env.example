# --- Email (Brevo) ---
BREVO_API_KEY=
# Must be a sender/domain verified in your Brevo account
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=LLM Wiki CRM

# --- Bootstrap ---
# Seeded as an admin in crm-data/.system/users/ on first start
ADMIN_EMAIL=

# --- App ---
APP_URL=http://localhost:3000
# Long random string used to sign login tokens and sessions (generate: openssl rand -hex 32)
AUTH_SECRET=
# Where the markdown wiki lives (its own git repo). Defaults to ./crm-data
CRM_DATA_DIR=
COMPANY_NAME=Our Company
# Your own email domains, so your reps are not created as customer contacts (comma separated)
OWN_COMPANY_DOMAINS=
DEFAULT_CURRENCY=USD

# --- LLM (Ollama) ---
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.8:latest
OLLAMA_NUM_CTX=32768
